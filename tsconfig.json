{
  // Type-checks the plain JavaScript without compiling it: the site still
  // ships its files as written (no build step). Types come from inference
  // plus JSDoc where inference can't tell. Run: npm run typecheck
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["scripts/**/*", "data/**/*", "tests/**/*", "qa/**/*.mjs", "*.config.*"],
  "exclude": ["node_modules", "dist", "scripts/vendor", "scripts/optimize-images.*", "scripts/generate-responsive.cjs", "qa/reports"]
}
