{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/products.html",
        "http://localhost/product.html#V1-PLT-005",
        "http://localhost/maker.html",
        "http://localhost/blog/designing-drainage.html"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox --headless=new", "skipAudits": ["uses-http2", "bf-cache"] }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.7 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "qa/reports/lighthouse" }
  }
}
