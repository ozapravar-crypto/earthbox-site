{
  "name": "site",
  "version": "1.0.0",
  "description": "Editorial archival site for EarthBox. Prerendered at build time so the Journal is readable without JavaScript.",
  "scripts": {
    "prerender": "node scripts/prerender.mjs",
    "seo": "node scripts/seo.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "test:unit": "node --test scripts/*.test.mjs",
    "test": "npm run test:unit && npm run lint && npm run typecheck && npm run check:unused && npm run check:dupes && node scripts/includes.mjs --check && npm run check:prerender && node scripts/seo.mjs --check && npm run check:assets && npm run check:contrast",
    "build": "node scripts/includes.mjs && node scripts/prerender.mjs && node scripts/seo.mjs && npm test && node scripts/dist.mjs",
    "dist": "node scripts/dist.mjs",
    "includes": "node scripts/includes.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:unused": "knip",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "qa:contrast": "node qa/contrast/audit.mjs",
    "qa:contrast:quick": "node qa/contrast/audit.mjs --quick",
    "typecheck": "tsc -p .",
    "check:dupes": "jscpd",
    "api:db": "wrangler d1 execute earthbox --local --file worker/schema.sql",
    "api:dev": "npm run api:db && wrangler dev --port 8787",
    "test:api": "node --test worker/api.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://ozapravar-crypto@github.com/ozapravar-crypto/earthbox-site.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ozapravar-crypto/earthbox-site/issues"
  },
  "homepage": "https://github.com/ozapravar-crypto/earthbox-site#readme",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.20.5",
    "axe-core": "^4.13.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jscpd": "^4.3.0",
    "knip": "6.41.0",
    "lenis": "^1.3.26",
    "sharp": "0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.152.0"
  }
}
